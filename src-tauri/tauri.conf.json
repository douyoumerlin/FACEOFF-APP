{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FaceOff",
  "version": "1.0.0",
  "identifier": "com.goat225.faceoff",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FaceOff",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#12274A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GOAT225",
    "copyright": "© 2026 GOAT225",
    "category": "Sports",
    "shortDescription": "FaceOff by GOAT225 : arbitrage des duels 1v1",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
